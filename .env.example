# ---------------------------------------------------------------------------
# AI Sales Demo Suite — configuration
# Copy to .env and fill in.  deploy.sh generates the secrets for you.
# ---------------------------------------------------------------------------

# Port the demo is published on (http://SERVER_IP:WEB_PORT)
WEB_PORT=8080

# --- database (internal only, never published) ------------------------------
POSTGRES_USER=aisales
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=aisales

# --- application ------------------------------------------------------------
ENVIRONMENT=production
# Signs the session cookie. Generate: openssl rand -hex 32
SECRET_KEY=change-me-32-bytes-hex

# Demo login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- LLM --------------------------------------------------------------------
# auto      — use a real provider if a key is present, otherwise the demo one
# anthropic — Anthropic Messages API
# openai    — any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, …)
# demo      — deterministic provider, no network calls
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- demo behaviour ---------------------------------------------------------
SEED_ON_STARTUP=true
SCHEDULER_ENABLED=true
# virtual minutes per real second (1 = real time, 60 = 1 s is 1 min)
DEMO_SPEED=60
